# ==============================================================================
# Financial Research & Report Generator - Environment Configuration Template
# ==============================================================================

# Google Cloud Platform Settings
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=l200-agent-project
GOOGLE_CLOUD_PROJECT_NUMBER=120662768527
GOOGLE_CLOUD_LOCATION=us-east1

# Model Tier Selection
FLASH_MODEL=gemini-2.5-flash
PRO_MODEL=gemini-2.5-pro

# Vertex AI Search / Discovery Engine Settings
VERTEX_SEARCH_DATASTORE_ID=sec-filings-datastore
VERTEX_SEARCH_ENGINE_ID=financial-search-engine

# Observability & Tracing Configuration
ENABLE_CLOUD_TRACE=true
LOG_LEVEL=INFO

# Optional API Keys (in production, loaded automatically from GCP Secret Manager)
# FINANCIAL_API_KEY=your-financial-api-key
# ALPHAVANTAGE_API_KEY=your-alphavantage-api-key
# POLYGON_API_KEY=your-polygon-api-key
